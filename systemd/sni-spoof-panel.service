[Unit]
Description=sni-spoof web panel
Documentation=https://github.com/chess902/Sni-spoof
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sni-spoof
ExecStart=/usr/bin/env python3 -m panel serve
Environment=PYTHONPATH=/opt/sni-spoof
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
LimitNOFILE=65535
# The panel drives systemctl and writes /etc/sni-spoof, so it stays privileged
# but is confined to the paths it actually needs.
NoNewPrivileges=false
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/sni-spoof /var/lib/sni-spoof /var/log/sni-spoof /usr/local/bin

[Install]
WantedBy=multi-user.target
