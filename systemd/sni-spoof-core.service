[Unit]
Description=sni-spoof core (DPI bypass TCP forwarder)
Documentation=https://github.com/chess902/Sni-spoof
After=network-online.target
Wants=network-online.target
# The core exits non-zero with no listeners; without this gate Restart=always
# turns "not configured yet" into a crash loop. The panel manages the flag.
ConditionPathExists=/etc/sni-spoof/core.enabled
ConditionPathExists=/etc/sni-spoof/core.json

[Service]
Type=simple
ExecStart=/usr/local/bin/sni-spoof-rs /etc/sni-spoof/core.json
Environment=RUST_LOG=warn
Restart=always
RestartSec=3
# Raw packet access is what the injection technique needs.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sni-spoof /var/log/sni-spoof
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
